# Copy to `.env` and fill in your token, then restart the dev server.
#
# With both set, the app stops serving mock data and calls this URL directly, and
# the banner disappears. While RAVN's API is offline (it answers 404), the board
# then shows its error state instead of tasks (docs/deployment.md).
# With either missing, it falls back to the MSW mock and runs offline — which is
# what lets someone clone this repo and see a working board without credentials.

VITE_API_URL=https://syn-api-production-e95c.up.railway.app/graphql

# Issued by RAVN over email. Never commit the real value; `.env` is gitignored.
VITE_API_TOKEN=
