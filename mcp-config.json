{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@context7/mcp@latest"]
    },
    "eslint": {
      "command": "npx",
      "args": ["@eslint/mcp@latest"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "graphql": {
      "command": "npx",
      "args": ["-y", "mcp-graphql"],
      "env": {
        "GRAPHQL_ENDPOINT": "https://syn-api-production-e95c.up.railway.app/graphql"
      }
    }
  }
}
